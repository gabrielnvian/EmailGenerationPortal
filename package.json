		"@types/node": "^25.4.0",
		"@vitest/browser-playwright": "^4.0.15",
		"@vitest/ui": "^4.0.17",
		"daisyui": "^5.5.19",
		"playwright": "^1.57.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
